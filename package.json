    "framer-motion": "^11.11.9",
    "leaflet": "^1.9.4",
    "lodash": "^4.18.1",
    "lucide-react": "^0.451.0",
    "next": "14.2.35",
    "pizzip": "^3.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.15.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.16.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
