{
  "name": "bj-residence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf:dev": "OPEN_NEXT_CLOUDFLARE_DEV=1 next dev",
    "cf:build": "OPEN_NEXT_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build",
