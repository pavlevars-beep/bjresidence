# Kopirajte ovaj fajl u .env.local i popunite vrednosti.
# .env.local se NE komituje u git (već je u .gitignore).

# Token koji dobijete od @BotFather kada napravite bota (vidi README.md)
TELEGRAM_BOT_TOKEN=

# Vaš lični chat ID na Telegramu — bot šalje poruke samo ovde i prihvata
# komande samo odavde (vidi README.md kako da ga dobijete)
TELEGRAM_CHAT_ID=

# Nasumičan, dugačak string koji vi izmislite — sprečava da neko drugi
# šalje lažne zahteve na /api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# --- Info Board (/info kiosk tabla + /admin) ---

# Lozinka za pristup /admin (izmislite nešto jako). Obavezno.
ADMIN_PASSWORD=

# Nasumičan, dugačak string koji vi izmislite — koristi se za potpisivanje
# admin sesije (kolačića). Obavezno, čim je ADMIN_PASSWORD podešen.
ADMIN_SESSION_SECRET=

# Opciono. Ako je podešen, "Saobraćaj sada" na /info koristi Google Distance
# Matrix API za saobraćajem-svesno vreme vožnje uživo. Bez ovoga, prikazuje se
# procenjeno vreme koje unesete u /admin (ništa se ne pokvari bez ovog ključa).
GOOGLE_MAPS_API_KEY=
